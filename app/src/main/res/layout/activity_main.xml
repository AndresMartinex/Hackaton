<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101233"
    android:orientation="vertical">

    <!-- Barra superior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#101233"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:strokeColor="#FF0000FF"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/outline_arrow_back_ios_24"
                android:contentDescription="@string/volver"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="juego acelerometro"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Zona del juego -->
    <com.tuapp.nombre.MazeView
        android:id="@+id/mazeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Barra inferior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#101233"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:strokeColor="#FF0000FF"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/abrir_camara"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#3F51B5"
            app:cornerRadius="8dp"
            app:icon="@drawable/outline_assistant_device_24"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>